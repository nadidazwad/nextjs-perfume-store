# ==============================================================================
# ATTAR — ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to `.env` and fill in what you need.
#
# IMPORTANT: In local development NOTHING here is required. With no .env file
# at all, Attar runs on an embedded database (PGlite), logs order notifications
# to the console, and stores uploaded images in public/uploads.
#
# Validation lives in src/lib/env.ts — if a value is wrong or missing when it
# is required, the app fails at startup with an exact error message.
# ==============================================================================


# ------------------------------------------------------------------------------
# DATABASE (required in production)
# ------------------------------------------------------------------------------
# Any Postgres works. Free options:
#   Neon:     https://neon.tech      (recommended: scales to zero, no card)
#   Supabase: https://supabase.com   (pauses after 1 week of inactivity on free tier)
# Leave unset in development to use the embedded PGlite database (.data/pglite).
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Public demo only (DEMO_MODE=true): a direct, non-pooled connection string.
# Each visitor sandbox gets its own small connection pinned to its schema, and
# Neon's pooler doesn't allow that. On Neon it's DATABASE_URL without
# "-pooler"; elsewhere it defaults to DATABASE_URL.
# DATABASE_URL_DIRECT=postgres://user:password@host/dbname?sslmode=require


# ------------------------------------------------------------------------------
# APP
# ------------------------------------------------------------------------------
# The public URL of your deployed store (no trailing slash).
# Required in production, and must be https:// (localhost is allowed for local
# Docker tests). It makes admin cookies Secure, and it's the only origin allowed
# to upload images.
# NEXT_PUBLIC_APP_URL=https://your-store.example.com

# Secret for admin session signing. Required in production.
# Generate with:  openssl rand -hex 32
# BETTER_AUTH_SECRET=

# Initial admin account created by `pnpm db:seed`.
# Defaults (local PGlite only): admin@example.com / admin1234. When DATABASE_URL
# is set, `pnpm db:seed` refuses to run until you change both.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please

# Set to false to seed only the admin account: no demo catalog, customers or
# orders. Use it for a real store's first deploy. Default: true.
# SEED_DEMO_DATA=true


# ------------------------------------------------------------------------------
# ORDER NOTIFICATIONS — how your team hears about new orders
# ------------------------------------------------------------------------------
# One of: console | resend | telegram        (default: console)
# NOTIFY_ADAPTER=console

# --- resend (email, free tier: 3,000 emails/month — https://resend.com) ------
# RESEND_API_KEY=
# NOTIFY_EMAIL_FROM=orders@your-domain.com
# NOTIFY_EMAIL_TO=team@your-domain.com

# --- telegram (free, instant; great for BD teams) -----------------------------
# 1. Message @BotFather on Telegram, create a bot, copy the token.
# 2. Add the bot to your team group, make it admin.
# 3. Get the chat id: https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=


# ------------------------------------------------------------------------------
# IMAGE STORAGE — where uploaded product images live
# ------------------------------------------------------------------------------
# One of: local | s3                          (default: local)
# "local" writes to .data/uploads and serves it at /uploads/<file>: fine for
# dev and a self-hosted server/Docker (mount .data as a volume to keep images).
# On Vercel/Cloudflare/serverless you MUST use "s3" (filesystem is read-only).
# Free S3-compatible option: Cloudflare R2 (10 GB free, zero egress fees).
# STORAGE_ADAPTER=local

# --- s3 / r2 -------------------------------------------------------------------
# For Cloudflare R2: endpoint is https://<account-id>.r2.cloudflarestorage.com
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=attar-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev


# ------------------------------------------------------------------------------
# PUBLIC DEMO (showcase deployments only; never on a real store)
# ------------------------------------------------------------------------------
# Lets any visitor open a private, expiring copy of the store with a demo admin
# login (/demo). Needs a Postgres DATABASE_URL (plus DATABASE_URL_DIRECT on
# Neon). See docs/deploy/public-demo.md. Default: false.
# DEMO_MODE=false

# Public demo only: protects the daily cleanup job (/api/cron/demo-cleanup,
# scheduled in vercel.json). Vercel sends it automatically once it's set.
# Generate with:  openssl rand -hex 32
# CRON_SECRET=
